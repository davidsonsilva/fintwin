      "default_drafter": "haiku-4.5",
      "default_verifier": "sonnet-5",
      "validation_threshold": 0.85
    },
    "documentation": {
      "default_drafter": "haiku-4.5",
      "default_verifier": "sonnet-5",
      "validation_threshold": 0.70
    },
    "complex_refactoring": {
      "default_drafter": "sonnet-5",
      "default_verifier": "opus-4.8",
      "validation_threshold": 0.90
    },
    "general": {
      "default_drafter": "haiku-4.5",
      "default_verifier": "opus-4.8",
      "validation_threshold": 0.75
    }
  }
}
